{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InkDOS",
  "version": "2.2.0",
  "identifier": "com.inkdos.desktop",
  "build": {
    "frontendDist": "../web-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "InkDOS",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "appimage", "rpm"],
    "category": "Productivity",
    "shortDescription": "Local-first productivity suite",
    "longDescription": "InkDOS is a local-first productivity suite for documents, spreadsheets, presentations, PDF, EPUB and plain text workflows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "name": "documents",
        "description": "InkDOS Documents",
        "ext": ["docx"]
      },
      {
        "name": "spreadsheets",
        "description": "InkDOS Spreadsheets",
        "ext": ["xls", "xlsx", "csv", "tsv"]
      },
      {
        "name": "presentations",
        "description": "InkDOS Presentations",
        "ext": ["pptx"]
      },
      {
        "name": "pdf",
        "description": "InkDOS PDF",
        "ext": ["pdf"]
      },
      {
        "name": "epub",
        "description": "InkDOS EPUB",
        "ext": ["epub"]
      },
      {
        "name": "txt",
        "description": "InkDOS Plain Text",
        "ext": ["txt", "xml", "md", "markdown", "json", "jsonl", "ndjson", "yaml", "yml", "log", "ini", "cfg", "conf", "toml", "properties"]
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
