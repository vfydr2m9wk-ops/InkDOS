{
  "project": "InkDesk",
  "version": "0.19.2-beta",
  "releaseName": "Release Packaging and Privacy Cleanup",
  "releaseType": "Beta",
  "releaseDate": "2026-08-04",
  "entryPoints": {
    "InkDesk.html": "index.html",
    "Documents.html": "apps/documents/index.html",
    "Spreadsheets.html": "apps/spreadsheets/index.html",
    "Presentations.html": "apps/presentations/index.html"
  },
  "runtimeDirectories": [
    "apps/documents",
    "apps/spreadsheets",
    "apps/presentations",
    "shared"
  ],
  "supportedFormats": [
    "DOCX",
    "XLS (BIFF8 import)",
    "XLSX",
    "PPTX"
  ],
  "buildRequired": false,
  "automaticRemoteRuntimeDependencies": false,
  "license": "MIT for original code; bundled third-party components retain upstream licenses.",
  "validation": {
    "repositoryValidation": true,
    "sourceAudit": true,
    "unitAndPackageTests": 53,
    "browserRegressionScripts": 11,
    "localPlaywrightChromium": true,
    "localPlaywrightFirefox": false,
    "localPlaywrightWebKit": false,
    "ciPlaywrightMatrixConfigured": true,
    "nativeSafari": false,
    "nativeFirefox": false,
    "nativeIPadOS": false,
    "installedPwaRuntime": false,
    "staticHttpAssets": true,
    "browserRegressionGroups": 5
  },
  "securityLimits": {
    "maxCompressedBytes": 52428800,
    "maxEntries": 3000,
    "maxUncompressedBytes": 167772160,
    "maxEntryUncompressedBytes": 33554432,
    "maxCompressionRatio": 200,
    "maxXmlPartBytes": 8388608,
    "maxAggregateXmlBytes": 50331648,
    "maxXmlDepth": 128,
    "maxXmlNodes": 100000,
    "maxXmlAttributes": 100000,
    "maxAttributesPerElement": 128,
    "maxXmlAttributeLength": 32768
  },
  "exportVerification": "SHA-256 and byte-length match after reopening the generated copy"
}
