{
  "name": "inkdesk",
  "version": "0.20.3.1",
  "private": true,
  "description": "A lightweight local-first browser productivity suite for focused DOCX, XLS/XLSX, PPTX, PDF, TXT and EPUB workflows.",
  "scripts": {
    "validate": "python3 scripts/validate_repository.py",
    "audit": "python3 scripts/audit_source.py",
    "test": "python3 -m unittest discover -s tests -p test_*.py",
    "test:architecture": "python3 scripts/check_no_legacy_runtime.py",
    "test:browser": "python3 scripts/run_browser_regressions.py",
    "test:release": "python3 scripts/run_release_validation.py",
    "test:update": "python3 -m unittest tests.test_update_package",
    "test:modules": "python3 -m unittest tests.test_modules",
    "modules:generate": "python3 scripts/generate_module_registry.py",
    "modules:check": "python3 scripts/generate_module_registry.py --check",
    "update:apply": "python3 scripts/apply_update_package.py",
    "release:build": "python3 scripts/build_release.py --output-dir dist",
    "release:metadata": "python3 scripts/generate_release_metadata.py",
    "test:shell": "python3 -m unittest tests.test_application_shell",
    "test:layout": "python3 -m unittest tests.test_workspace_layout",
    "test:pdf-shell": "python3 -m unittest tests.test_pdf_shell_polish",
    "test:pdf-text": "python3 -m unittest tests.test_pdf_text_selection",
    "test:documents-ruler": "python3 -m unittest tests.test_documents_ruler",
    "test:spreadsheet-formula-references": "python3 -m unittest tests.test_spreadsheet_formula_references",
    "test:spreadsheet-formula-editor": "python3 -m unittest tests.test_spreadsheet_formula_editor",
    "test:spreadsheet-formula-session": "python3 -m unittest tests.test_spreadsheet_formula_editor",
    "test:update-workflow-observability": "python3 -m unittest tests.test_update_workflow_observability",
    "test:visual-foundation": "python3 -m unittest tests.test_visual_foundation",
    "test:pdf-unified-save": "python3 -m unittest tests.test_pdf_unified_save",
    "test:home-session-refinement": "python3 -m unittest tests.test_home_session_refinement",
    "test:txt": "python3 -m unittest tests.test_txt_module",
    "test:epub": "python3 -m unittest tests.test_epub_module",
    "test:consolidated-release": "python3 -m unittest tests.test_v0200_release",
    "test:consistency-regressions": "python3 -m unittest tests.test_v0201_consistency",
    "test:browser:matrix": "python3 scripts/run_browser_matrix.py",
    "test:data-safety": "python3 -m unittest tests.test_local_recovery",
    "test:guardrails": "python3 scripts/check_architecture_guardrails.py",
    "test:pdf-save-modularization": "python3 -m unittest tests.test_pdf_save_modularization",
    "test:workspace-panels": "python3 -m unittest tests.test_workspace_panel_modularization",
    "test:documents-ruler-model": "python3 -m unittest tests.test_documents_ruler_model_modularization",
    "test:documents-ruler-drag": "python3 -m unittest tests.test_documents_ruler_drag_modularization",
    "test:spreadsheet-formula-model": "python3 -m unittest tests.test_spreadsheet_formula_model_modularization",
    "test:spreadsheet-formula-lifecycle": "python3 -m unittest tests.test_spreadsheet_formula_session_modularization",
    "test:spreadsheet-formula-safety": "python3 -m unittest tests.test_spreadsheet_formula_safety",
    "test:spreadsheet-formula-recovery": "python3 -m unittest tests.test_spreadsheet_formula_recovery",
    "test:spreadsheet-history-safety": "python3 -m unittest tests.test_spreadsheet_history_safety",
    "test:recovery-source-continuity": "python3 -m unittest tests.test_local_recovery",
    "test:recovery-source-rehydration": "python3 -m unittest tests.test_local_recovery tests.test_release_metadata_consistency",
    "test:visual-foundation-0203": "python3 -m unittest tests.test_visual_foundation_0203",
    "test:content-workspaces-visual": "python3 -m unittest tests.test_content_workspaces_visual_02031"
  },
  "license": "MIT"
}
