{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vfydr2m9wk-ops.github.io/InkDOS/schemas/module-v1.json",
  "title": "InkDOS workspace module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "version",
    "enabled",
    "optional",
    "order",
    "entryPoint",
    "icon",
    "badge",
    "themeClass",
    "accent",
    "extensions",
    "mimeTypes",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "optional": {
      "type": "boolean"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "entryPoint": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "badge": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4
    },
    "themeClass": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+$"
      }
    },
    "mimeTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "shortLabel": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "createAction": {
      "type": [
        "string",
        "null"
      ]
    },
    "openAction": {
      "type": [
        "string",
        "null"
      ]
    },
    "createLabel": {
      "type": [
        "string",
        "null"
      ]
    },
    "openLabel": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
