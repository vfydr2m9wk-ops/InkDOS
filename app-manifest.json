{
  "schemaVersion": 1,
  "id": "inkdesk",
  "name": "InkDesk",
  "version": "0.19.3-beta.7",
  "description": "A lightweight local-first productivity suite for focused DOCX, XLS/XLSX, PPTX and PDF workflows.",
  "entryPoint": "index.html",
  "source": "https://github.com/vfydr2m9wk-ops/InkDesk",
  "homepage": "https://vfydr2m9wk-ops.github.io/InkDesk/",
  "icons": {
    "default": "assets/icons/office.png",
    "windows": "assets/icons/office.ico",
    "macos": "assets/icons/office.png",
    "linux": "assets/icons/office.png"
  },
  "moduleSystem": {
    "schemaVersion": 1,
    "configuration": "modules/module-config.json",
    "registry": "modules/module-registry.js",
    "loader": "modules/module-loader.js",
    "schema": "modules/module-schema.json",
    "generator": "scripts/generate_module_registry.py"
  },
  "launchers": [
    {
      "id": "suite",
      "name": "InkDesk",
      "entryPoint": "index.html",
      "icon": "assets/icons/office.png"
    },
    {
      "id": "documents",
      "name": "Documents",
      "entryPoint": "apps/documents/index.html",
      "icon": "assets/icons/documents.png"
    },
    {
      "id": "spreadsheets",
      "name": "Spreadsheets",
      "entryPoint": "apps/spreadsheets/index.html",
      "icon": "assets/icons/spreadsheets.png"
    },
    {
      "id": "presentations",
      "name": "Presentations",
      "entryPoint": "apps/presentations/index.html",
      "icon": "assets/icons/presentations.png"
    },
    {
      "id": "pdf",
      "name": "PDF Workspace",
      "entryPoint": "apps/pdf/index.html",
      "icon": "assets/icons/pdf.png"
    }
  ],
  "permissions": [
    "local-files",
    "downloads"
  ],
  "update": {
    "type": "github-release",
    "repository": "vfydr2m9wk-ops/InkDesk",
    "assetPattern": "InkDesk_v*.zip"
  },
  "capabilities": {
    "documents": [
      "docx-basic-open",
      "docx-basic-edit",
      "docx-package-preserving-copy-export",
      "docx-section-aware-layout",
      "docx-deny-by-default-dom",
      "docx-active-page-ruler",
      "docx-page-width-linked-ruler",
      "docx-zoom-aware-ruler",
      "docx-section-aware-ruler",
      "docx-ruler-margin-zones",
      "docx-ruler-dynamic-indent-mapping"
    ],
    "spreadsheets": [
      "xls-biff8-local-import",
      "xls-biff8-number-format-aware-zero-display",
      "xls-to-xlsx-copy-export",
      "xlsx-basic-open",
      "xlsx-basic-edit",
      "xlsx-package-preserving-copy-export",
      "xlsx-drawing-image-and-chart-preview",
      "xlsx-modern-formula-preview",
      "xlsx-hidden-sheet-respect",
      "bounded-deterministic-formula-evaluation",
      "xlsx-formula-mouse-reference-selection",
      "xlsx-formula-drag-range-selection",
      "xlsx-formula-discontinuous-reference-selection",
      "xlsx-formula-target-cell-preservation",
      "xlsx-formula-touch-add-range",
      "xlsx-formula-live-reference-preview",
      "xlsx-in-cell-formula-editor",
      "xlsx-enter-confirms-formula",
      "xlsx-tab-accepts-function-suggestion",
      "xlsx-cell-reference-aware-suggestions",
      "xlsx-balance-parentheses-on-commit",
      "xlsx-expanded-formula-bar",
      "xlsx-persistent-formula-draft",
      "xlsx-formula-draft-survives-cell-switch",
      "xlsx-normal-size-in-cell-formula-editing",
      "xlsx-successive-click-references",
      "xlsx-postfix-percentage"
    ],
    "presentations": [
      "pptx-basic-open",
      "pptx-basic-edit",
      "pptx-present",
      "pptx-package-preserving-copy-export",
      "pptx-layout-master-image-notes-resolution",
      "pptx-chart-and-transition-preview",
      "fingerprint-verified-export-reopen"
    ],
    "pdf": [
      "pdf-local-open",
      "pdf-initial-selector-routing",
      "pdf-native-browser-preview",
      "pdf-system-viewer-fallback",
      "pdf-page-count-and-jump",
      "pdf-outline-inspection",
      "pdf-vertical-and-horizontal-view-modes",
      "pdf-fullscreen-and-immersive-fallback",
      "pdf-native-acroform-interaction",
      "pdf-local-review-layer",
      "pdf-highlight-underline-marker-comment-and-text",
      "pdf-personal-bookmarks",
      "pdf-bounded-slice-inspection",
      "pdf-single-native-viewer-instance",
      "pdf-windowed-page-navigation",
      "pdf-page-hash-reload-navigation",
      "pdf-zoom-50-to-400",
      "pdf-fullscreen-exit-recovery",
      "pdf-object-url-file-lifecycle",
      "pdf-selected-text-highlight",
      "pdf-selected-text-underline",
      "pdf-selected-text-comment",
      "pdf-multiline-selection-segments",
      "pdf-multipage-linked-selection",
      "pdf-free-marker-isolation",
      "pdf-unified-save",
      "pdf-flatten-review-to-copy",
      "pdf-rendered-page-export",
      "pdf-comment-callout-export",
      "pdf-single-save-command",
      "pdf-form-state-preserving-save-without-review"
    ]
  },
  "compatibility": {
    "policy": "docs/COMPATIBILITY_POLICY.md",
    "status": "beta"
  },
  "uiSystem": {
    "schemaVersion": 1,
    "version": "0.19.4.3",
    "bootstrap": "shared/office-shell.js",
    "runtime": "shared/ui/application-shell.js",
    "tokens": "shared/ui/design-tokens.css",
    "components": "shared/ui/components.css",
    "contract": "shared/ui/shell-contract.json",
    "documentation": "docs/APPLICATION_SHELL.md",
    "workspaceLayout": {
      "schemaVersion": 1,
      "version": "0.19.4.7",
      "stylesheet": "shared/ui/workspace-layout.css",
      "runtime": "shared/ui/workspace-layout.js",
      "documentation": "docs/PDF_SHELL_POLISH.md",
      "defaults": {
        "documentsSidebar": "closed",
        "presentationThumbnails": "open",
        "presentationFormatPanel": "closed",
        "presentationNotes": "closed",
        "pdfOpenAction": "centered",
        "pdfSidebar": "closed",
        "pdfAccent": "#b42318"
      },
      "documentsRuler": {
        "schemaVersion": 1,
        "version": "0.19.4.7",
        "mode": "active-page",
        "units": "96-css-pixels-per-inch",
        "tracksZoom": true,
        "tracksHorizontalScroll": true,
        "tracksSectionPageWidth": true,
        "marginZones": true,
        "documentation": "docs/DOCUMENTS_RULER.md"
      }
    },
    "visualFoundation": {
      "schemaVersion": 1,
      "version": "0.19.4.11",
      "stylesheet": "shared/ui/visual-foundation.css",
      "fontStack": "-apple-system, BlinkMacSystemFont, SF Pro Text, SF Pro Display, Segoe UI Variable Text, Segoe UI, system-ui, sans-serif",
      "controlRadius": 11,
      "startButtonHeight": 50,
      "buttonStates": [
        "default",
        "hover",
        "pressed",
        "selected",
        "disabled"
      ],
      "roundedSurfaces": true,
      "raisedRetractablePanels": true,
      "documentation": "docs/VISUAL_FOUNDATION.md"
    }
  },
  "pdfReviewSystem": {
    "schemaVersion": 1,
    "version": "0.19.4.6",
    "storageSchema": "inkdesk-pdf-review/2",
    "selectedTextTools": [
      "highlight",
      "underline",
      "comment"
    ],
    "freeAnnotationTools": [
      "marker",
      "text"
    ],
    "geometry": "normalized page-relative rectangles derived from PDF.js text-layer selection",
    "documentation": "docs/PDF_TEXT_SELECTION.md"
  },
  "spreadsheetFormulaReferenceSystem": {
    "schemaVersion": 1,
    "version": "0.19.4.10",
    "runtime": "apps/spreadsheets/formula-reference.js",
    "stylesheet": "apps/spreadsheets/formula-reference.css",
    "targetCell": "preserved while selecting references",
    "selectionModes": [
      "single-cell",
      "drag-range",
      "ctrl-or-command-discontinuous",
      "touch-add-range-button"
    ],
    "confirmation": "Enter",
    "cancellation": "Escape",
    "documentation": "docs/SPREADSHEET_FORMULA_REFERENCES.md",
    "autoCloseDuringRangeSelection": false,
    "parenthesesBalancedOnCommit": true,
    "formulaEditorIntegration": "apps/spreadsheets/formula-editor.js",
    "successiveClicksAppend": true
  },
  "spreadsheetFormulaEditorSystem": {
    "schemaVersion": 2,
    "version": "0.19.4.10",
    "runtime": "apps/spreadsheets/formula-editor.js",
    "stylesheet": "apps/spreadsheets/formula-editor.css",
    "mode": "persistent in-cell draft session",
    "draftSurvivesCellSwitch": true,
    "minimumSuggestionLetters": 2,
    "suggestionAccept": [
      "Tab",
      "pointer"
    ],
    "formulaConfirm": "Enter",
    "formulaCancel": "Escape",
    "referenceSelection": [
      "single-cell",
      "drag-range",
      "successive-clicks",
      "ctrl-command",
      "touch-add-range"
    ],
    "percentageOperator": "postfix percentage",
    "remainderFunction": "MOD",
    "documentation": "docs/SPREADSHEET_FORMULA_SESSION.md"
  },
  "updateWorkflowObservability": {
    "schemaVersion": 1,
    "version": "0.19.4.10",
    "failureLogTail": true,
    "rollbackStatus": true,
    "automaticDiagnosis": true,
    "failureReportJson": true,
    "documentation": "docs/UPDATE_WORKFLOW_OBSERVABILITY.md"
  },
  "iconSystem": {
    "schemaVersion": 1,
    "version": "0.19.4.11",
    "catalog": "assets/icons/icon-catalog.json",
    "format": [
      "svg",
      "png"
    ],
    "primary": "quill-and-inkwell",
    "plannedModuleIcons": [
      "epub",
      "txt"
    ],
    "documentation": "docs/ICON_SYSTEM.md"
  },
  "uiCapabilities": [
    "rounded-tactile-buttons",
    "apple-like-system-font-stack",
    "selected-control-color-state",
    "pressed-control-depth-state",
    "raised-three-dimensional-side-panels",
    "minimal-module-iconography"
  ],
  "pdfSaveSystem": {
    "schemaVersion": 1,
    "version": "0.19.4.12",
    "runtime": "apps/pdf/flatten-export.js",
    "stylesheet": "apps/pdf/flatten-export.css",
    "visibleActions": [
      "open",
      "save",
      "open-in-system-viewer",
      "fullscreen"
    ],
    "removedVisibleActions": [
      "export-review-json",
      "import-review-json",
      "save-original",
      "print",
      "parallel-save-pdf-copy"
    ],
    "saveModes": {
      "withoutInkDeskAnnotations": "PDF.js saveDocument preserves supported form state and selectable source structure",
      "withInkDeskAnnotations": "flattened rendered-page PDF with portable visible review marks"
    },
    "annotationTypes": [
      "highlight",
      "underline",
      "comment",
      "marker",
      "text"
    ],
    "editableReviewPersistence": "local sidecar remains available",
    "annotatedExportTextSelectable": false,
    "visualFoundation": "0.19.4.11",
    "documentation": "docs/PDF_UNIFIED_SAVE.md"
  }
}
