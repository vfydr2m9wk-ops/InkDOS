{
  "schemaVersion": 1,
  "id": "inkdesk",
  "name": "InkDesk",
  "version": "0.19.3-beta.7",
  "description": "A lightweight local-first productivity suite for focused DOCX, XLS/XLSX, PPTX and PDF workflows.",
  "entryPoint": "index.html",
  "source": "https://github.com/vfydr2m9wk-ops/InkDesk",
  "homepage": "https://vfydr2m9wk-ops.github.io/InkDesk/",
  "icons": {
    "default": "assets/icons/office.png",
    "windows": "assets/icons/office.ico",
    "macos": "assets/icons/office.png",
    "linux": "assets/icons/office.png"
  },
  "moduleSystem": {
    "schemaVersion": 1,
    "configuration": "modules/module-config.json",
    "registry": "modules/module-registry.js",
    "loader": "modules/module-loader.js",
    "schema": "modules/module-schema.json",
    "generator": "scripts/generate_module_registry.py"
  },
  "launchers": [
    {
      "id": "suite",
      "name": "InkDesk",
      "entryPoint": "index.html",
      "icon": "assets/icons/office.png"
    },
    {
      "id": "documents",
      "name": "Documents",
      "entryPoint": "apps/documents/index.html",
      "icon": "assets/icons/documents.png"
    },
    {
      "id": "spreadsheets",
      "name": "Spreadsheets",
      "entryPoint": "apps/spreadsheets/index.html",
      "icon": "assets/icons/spreadsheets.png"
    },
    {
      "id": "presentations",
      "name": "Presentations",
      "entryPoint": "apps/presentations/index.html",
      "icon": "assets/icons/presentations.png"
    },
    {
      "id": "pdf",
      "name": "PDF Workspace",
      "entryPoint": "apps/pdf/index.html",
      "icon": "assets/icons/pdf.png"
    }
  ],
  "permissions": [
    "local-files",
    "downloads"
  ],
  "update": {
    "type": "github-release",
    "repository": "vfydr2m9wk-ops/InkDesk",
    "assetPattern": "InkDesk_v*.zip"
  },
  "capabilities": {
    "documents": [
      "docx-basic-open",
      "docx-basic-edit",
      "docx-package-preserving-copy-export",
      "docx-section-aware-layout",
      "docx-deny-by-default-dom",
      "docx-active-page-ruler",
      "docx-page-width-linked-ruler",
      "docx-zoom-aware-ruler",
      "docx-section-aware-ruler",
      "docx-ruler-margin-zones",
      "docx-ruler-dynamic-indent-mapping"
    ],
    "spreadsheets": [
      "xls-biff8-local-import",
      "xls-biff8-number-format-aware-zero-display",
      "xls-to-xlsx-copy-export",
      "xlsx-basic-open",
      "xlsx-basic-edit",
      "xlsx-package-preserving-copy-export",
      "xlsx-drawing-image-and-chart-preview",
      "xlsx-modern-formula-preview",
      "xlsx-hidden-sheet-respect",
      "bounded-deterministic-formula-evaluation"
    ],
    "presentations": [
      "pptx-basic-open",
      "pptx-basic-edit",
      "pptx-present",
      "pptx-package-preserving-copy-export",
      "pptx-layout-master-image-notes-resolution",
      "pptx-chart-and-transition-preview",
      "fingerprint-verified-export-reopen"
    ],
    "pdf": [
      "pdf-local-open",
      "pdf-initial-selector-routing",
      "pdf-native-browser-preview",
      "pdf-system-viewer-fallback",
      "pdf-page-count-and-jump",
      "pdf-outline-inspection",
      "pdf-vertical-and-horizontal-view-modes",
      "pdf-fullscreen-and-immersive-fallback",
      "pdf-native-acroform-interaction",
      "pdf-local-review-layer",
      "pdf-highlight-underline-marker-comment-and-text",
      "pdf-personal-bookmarks",
      "pdf-review-sidecar-import-export",
      "pdf-original-download",
      "pdf-bounded-slice-inspection",
      "pdf-single-native-viewer-instance",
      "pdf-windowed-page-navigation",
      "pdf-page-hash-reload-navigation",
      "pdf-zoom-50-to-400",
      "pdf-fullscreen-exit-recovery",
      "pdf-object-url-file-lifecycle",
      "pdf-selected-text-highlight",
      "pdf-selected-text-underline",
      "pdf-selected-text-comment",
      "pdf-multiline-selection-segments",
      "pdf-multipage-linked-selection",
      "pdf-free-marker-isolation"
    ]
  },
  "compatibility": {
    "policy": "docs/COMPATIBILITY_POLICY.md",
    "status": "beta"
  },
  "uiSystem": {
    "schemaVersion": 1,
    "version": "0.19.4.3",
    "bootstrap": "shared/office-shell.js",
    "runtime": "shared/ui/application-shell.js",
    "tokens": "shared/ui/design-tokens.css",
    "components": "shared/ui/components.css",
    "contract": "shared/ui/shell-contract.json",
    "documentation": "docs/APPLICATION_SHELL.md",
    "workspaceLayout": {
      "schemaVersion": 1,
      "version": "0.19.4.7",
      "stylesheet": "shared/ui/workspace-layout.css",
      "runtime": "shared/ui/workspace-layout.js",
      "documentation": "docs/PDF_SHELL_POLISH.md",
      "defaults": {
        "documentsSidebar": "closed",
        "presentationThumbnails": "open",
        "presentationFormatPanel": "closed",
        "presentationNotes": "closed",
        "pdfOpenAction": "centered",
        "pdfSidebar": "closed",
        "pdfAccent": "#b42318"
      },
      "documentsRuler": {
        "schemaVersion": 1,
        "version": "0.19.4.7",
        "mode": "active-page",
        "units": "96-css-pixels-per-inch",
        "tracksZoom": true,
        "tracksHorizontalScroll": true,
        "tracksSectionPageWidth": true,
        "marginZones": true,
        "documentation": "docs/DOCUMENTS_RULER.md"
      }
    }
  },
  "pdfReviewSystem": {
    "schemaVersion": 1,
    "version": "0.19.4.6",
    "storageSchema": "inkdesk-pdf-review/2",
    "selectedTextTools": [
      "highlight",
      "underline",
      "comment"
    ],
    "freeAnnotationTools": [
      "marker",
      "text"
    ],
    "geometry": "normalized page-relative rectangles derived from PDF.js text-layer selection",
    "documentation": "docs/PDF_TEXT_SELECTION.md"
  }
}
