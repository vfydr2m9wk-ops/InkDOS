    "presentations": [
      "pptx-basic-open",
      "pptx-basic-edit",
      "pptx-present",
      "pptx-package-preserving-copy-export",
      "pptx-layout-master-image-notes-resolution",
      "pptx-chart-and-transition-preview",
      "fingerprint-verified-export-reopen",
      "editable-file-title",
      "unsaved-change-navigation-warning",
      "private-indexeddb-recovery-snapshots"
    ],
    "pdf": [
      "pdf-local-open",
      "pdf-initial-selector-routing",
      "pdf-native-browser-preview",
      "pdf-system-viewer-fallback",
      "pdf-page-count-and-jump",
      "pdf-outline-inspection",
      "pdf-vertical-and-horizontal-view-modes",
      "pdf-fullscreen-and-immersive-fallback",
      "pdf-native-acroform-interaction",
      "pdf-local-review-layer",
      "pdf-highlight-underline-marker-comment-and-text",
      "pdf-personal-bookmarks",
      "pdf-bounded-slice-inspection",
      "pdf-single-native-viewer-instance",
      "pdf-windowed-page-navigation",
      "pdf-page-hash-reload-navigation",
      "pdf-zoom-50-to-400",
      "pdf-fullscreen-exit-recovery",
      "pdf-object-url-file-lifecycle",
      "pdf-selected-text-highlight",
      "pdf-selected-text-underline",
      "pdf-selected-text-comment",
      "pdf-multiline-selection-segments",
      "pdf-multipage-linked-selection",
      "pdf-free-marker-isolation",
      "pdf-unified-save",
      "pdf-flatten-review-to-copy",
      "pdf-rendered-page-export",
      "pdf-comment-callout-export",
      "pdf-single-save-command",
      "pdf-form-state-preserving-save-without-review",
      "editable-file-title",
      "unsaved-change-navigation-warning"
    ],
    "txt": [
      "txt-local-open",
      "txt-new",
      "txt-basic-edit",
      "txt-utf8-save-copy",
      "txt-utf16-open",
      "txt-line-ending-preservation",
      "txt-find",
      "txt-word-wrap",
      "txt-font-size",
      "txt-word-line-character-count",
      "editable-file-title",
      "unsaved-change-navigation-warning"
    ],
    "epub": [
      "epub-local-open",
      "epub-read-only",
      "epub-lateral-pagination",
      "epub-font-size",
      "epub-reading-themes",
      "epub-table-of-contents",
      "epub-simple-images",
      "epub-save-renamed-copy",
      "editable-file-title",
      "unsaved-change-navigation-warning"
    ]
  },
  "compatibility": {
    "policy": "docs/COMPATIBILITY_POLICY.md",
    "status": "beta"
  },
  "uiSystem": {
    "schemaVersion": 1,
    "version": "0.20.0",
    "bootstrap": "shared/office-shell.js",
    "runtime": "shared/ui/application-shell.js",
    "tokens": "shared/ui/design-tokens.css",
    "components": "shared/ui/components.css",
    "contract": "shared/ui/shell-contract.json",
    "documentation": "docs/APPLICATION_SHELL.md",
    "workspaceLayout": {
      "schemaVersion": 1,
      "version": "0.20.0",
      "stylesheet": "shared/ui/workspace-layout.css",
      "runtime": "shared/ui/workspace-layout.js",
      "documentation": "docs/PDF_SHELL_POLISH.md",
      "defaults": {
        "documentsSidebar": "closed",
        "presentationThumbnails": "open",
        "presentationFormatPanel": "closed",
        "presentationNotes": "closed",
        "pdfOpenAction": "centered",
        "pdfSidebar": "closed",
        "pdfAccent": "#b42318"
      },
      "documentsRuler": {
        "schemaVersion": 1,
        "version": "0.20.0",
        "mode": "active-page",
        "units": "96-css-pixels-per-inch",
        "tracksZoom": true,
        "tracksHorizontalScroll": true,
        "tracksSectionPageWidth": true,
        "marginZones": true,
        "documentation": "docs/DOCUMENTS_RULER.md",
        "model": "shared/ui/document-ruler-model.js",
        "dragController": "shared/ui/document-ruler-drag-controller.js"
      },
      "panelController": "shared/ui/workspace-panel-controller.js"
    },
    "visualFoundation": {
      "schemaVersion": 1,
      "version": "0.20.0",
      "stylesheet": "shared/ui/visual-foundation.css",
      "fontStack": "-apple-system, BlinkMacSystemFont, SF Pro Text, SF Pro Display, Segoe UI Variable Text, Segoe UI, system-ui, sans-serif",
      "controlRadius": 11,
      "startButtonHeight": 50,
      "buttonStates": [
        "default",
        "hover",
        "pressed",
        "selected",
        "disabled"
      ],
      "roundedSurfaces": true,
      "raisedRetractablePanels": true,
      "documentation": "docs/VISUAL_FOUNDATION.md"
    },
    "currentVisualLayer": {
      "schemaVersion": 1,
      "version": "1.0.0-beta.3",
      "layering": "loaded after existing Home/workspace styles",
      "titlebarMinimum": 44,
      "productAccents": {
        "documents": "#2f6fed",
        "spreadsheets": "#267a45",
        "presentations": "#d64a24",
        "pdf": "#b42318",
        "txt": "#d9a514",
        "epub": "#7655c7"
      },
      "documentation": "docs/VISUAL_SYSTEM.md",
      "dataPathChanges": false,
      "stylesheets": [
        "shared/ui/visual.css",
        "shared/ui/content.css",
        "shared/ui/workspace.css",
        "shared/ui/polish.css"
      ]
    }
  },
  "pdfReviewSystem": {
    "schemaVersion": 1,
    "version": "0.20.0",
    "storageSchema": "inkdos-pdf-review/2",
    "selectedTextTools": [
      "highlight",
      "underline",
      "comment"
    ],
    "freeAnnotationTools": [
      "marker",
      "text"
    ],
    "geometry": "normalized page-relative rectangles derived from PDF.js text-layer selection",
    "documentation": "docs/PDF_TEXT_SELECTION.md"
  },
  "spreadsheetFormulaReferenceSystem": {
    "schemaVersion": 1,
    "version": "0.20.1",
    "runtime": "apps/spreadsheets/formula-reference.js",
    "stylesheet": "apps/spreadsheets/formula-reference.css",
    "targetCell": "preserved while selecting references",
    "selectionModes": [
      "single-cell",
      "drag-range",
      "ctrl-or-command-discontinuous",
      "touch-add-range-button"
    ],
    "confirmation": "Enter",
    "cancellation": "Escape",
    "documentation": "docs/SPREADSHEET_FORMULA_REFERENCES.md",
    "autoCloseDuringRangeSelection": false,
    "parenthesesBalancedOnCommit": true,
    "formulaEditorIntegration": "apps/spreadsheets/formula-editor.js",
    "successiveClicksAppend": true,
    "normalGridSelectionIsolation": true,
    "referenceCaptureMode": "armed-only",
    "normalRangeDrag": "global-pointer-hit-testing"
  },
  "spreadsheetFormulaEditorSystem": {
    "schemaVersion": 2,
    "version": "0.20.0",
    "runtime": "apps/spreadsheets/formula-editor.js",
    "stylesheet": "apps/spreadsheets/formula-editor.css",
    "mode": "persistent in-cell draft session",
    "draftSurvivesCellSwitch": true,
    "minimumSuggestionLetters": 2,
    "suggestionAccept": [
      "Tab",
      "pointer"
    ],
    "formulaConfirm": "Enter",
    "formulaCancel": "Escape",
    "referenceSelection": [
      "single-cell",
      "drag-range",
      "successive-clicks",
      "ctrl-command",
      "touch-add-range"
    ],
    "percentageOperator": "postfix percentage",
    "remainderFunction": "MOD",
    "documentation": "docs/SPREADSHEET_FORMULA_SESSION.md",
    "model": "apps/spreadsheets/formula-model.js",
    "session": "apps/spreadsheets/formula-session.js",
    "safety": "apps/spreadsheets/formula-safety.js",
    "pendingDraftsCountAsUnsaved": true,
    "saveBlockedWhileDraftsPending": true,
    "draftResetOnConfirmedWorkbookReplacement": true,
    "failedOpenPreservesExistingDrafts": true,
    "recoverySnapshot": "private IndexedDB via shared/local-recovery.js",
    "pendingDraftsRecoverable": true,
    "restoredDraftsResumeWithoutSilentCommit": true
  },
  "updateWorkflowObservability": {
    "schemaVersion": 1,
    "version": "0.20.0",
    "failureLogTail": true,
    "rollbackStatus": true,
    "automaticDiagnosis": true,
    "failureReportJson": true,
    "documentation": "docs/UPDATE_WORKFLOW_OBSERVABILITY.md"
  },
  "iconSystem": {
    "schemaVersion": 1,
    "version": "0.20.0",
    "catalog": "assets/icons/icon-catalog.json",
    "format": [
      "svg",
      "png"
    ],
    "primary": "quill-and-inkwell",
    "plannedModuleIcons": [],
    "documentation": "docs/ICON_SYSTEM.md",
    "activeModuleIcons": [
      "documents",
      "spreadsheets",
      "presentations",
      "pdf",
      "txt",
      "epub"
    ]
  },
  "uiCapabilities": [
    "rounded-tactile-buttons",
    "apple-like-system-font-stack",
    "selected-control-color-state",
    "pressed-control-depth-state",
    "raised-three-dimensional-side-panels",
    "minimal-module-iconography"
  ],
  "pdfSaveSystem": {
    "schemaVersion": 1,
    "version": "0.20.0",
    "runtime": "apps/pdf/flatten-export.js",
    "stylesheet": "apps/pdf/flatten-export.css",
    "visibleActions": [
      "open",
      "save",
      "open-in-system-viewer",
      "fullscreen"
    ],
    "removedVisibleActions": [
      "export-review-json",
      "import-review-json",
      "save-original",
      "print",
      "parallel-save-pdf-copy"
    ],
    "saveModes": {
      "withoutInkDOSAnnotations": "PDF.js saveDocument preserves supported form state and selectable source structure",
      "withInkDOSAnnotations": "flattened rendered-page PDF with portable visible review marks"
    },
    "annotationTypes": [
      "highlight",
      "underline",
      "comment",
      "marker",
      "text"
    ],
    "editableReviewPersistence": "local sidecar remains available",
    "annotatedExportTextSelectable": false,
    "visualFoundation": "0.20.0",
    "documentation": "docs/PDF_UNIFIED_SAVE.md"
  },
  "homeRefinement": {
    "version": "0.20.0",
    "compactStatusNearFooter": true,
    "buildInFooter": true
  },
  "documentSessionSystem": {
    "version": "0.20.0",
    "sharedLifecycle": "shared/file-lifecycle.js",
    "automaticBeforeUnloadGuard": true,
    "editableTitles": {
      "documents": ".docx",
      "spreadsheets": ".xlsx",
      "presentations": ".pptx",
      "pdf": ".pdf",
      "txt": ".txt",
      "epub": ".epub"
    },
    "plannedModules": {},
    "implementation": "shared UI document-session controller composed by shared/office-shell.js",
    "replacesCompleteApplicationFiles": false,
    "downloadNameRewriting": true,
    "preservesInstalledApplicationRuntime": true,
    "runtime": "shared/ui/document-session-controller.js"
  },
  "txtEditorSystem": {
    "schemaVersion": 1,
    "version": "0.20.0",
    "module": "apps/txt/module.json",
    "entryPoint": "apps/txt/index.html",
    "runtime": "apps/txt/app.js",
    "stylesheet": "apps/txt/styles.css",
    "maximumFileBytes": 20971520,
    "openEncodings": [
      "UTF-8",
      "UTF-8 BOM",
      "UTF-16 LE",
      "UTF-16 BE"
    ],
    "saveEncoding": "UTF-8",
    "preservesDetectedLineEnding": true,
    "features": [
      "new",
      "open",
      "edit",
      "save-copy",
      "find-next-previous",
      "word-wrap",
      "font-size",
      "undo-redo",
      "word-line-character-count"
    ],
    "localProcessing": true,
    "documentation": "docs/TXT_EDITOR.md"
  },
  "epubReaderSystem": {
    "schemaVersion": 1,
    "version": "0.20.0",
    "module": "apps/epub/module.json",
    "entryPoint": "apps/epub/index.html",
    "parser": "apps/epub/epub-parser.js",
    "runtime": "apps/epub/app.js",
    "stylesheet": "apps/epub/styles.css",
    "archiveRuntime": "shared/vendor/jszip.min.js",
    "maximumFileBytes": 104857600,
    "readingMode": "sanitized simple text with local images",
    "pagination": "lateral generated pages",
    "themes": [
      "paper",
      "sepia",
      "sage",
      "night"
    ],
    "fontSizeRange": [
      13,
      30
    ],
    "contentEditing": false,
    "saveMode": "unchanged EPUB copy under edited filename",
    "localProcessing": true,
    "documentation": "docs/EPUB_READER.md"
  },
  "release": {
    "version": "1.0.0-beta.3",
    "channel": "beta",
    "name": "1.0 Beta 3",
    "date": "2026-09-04",
    "consolidated": true
  },
  "consistencyRefinement": {
    "schemaVersion": 1,
    "version": "0.20.1",
    "phase": "refinement-and-stabilization",
    "releaseBlockers": [
      "lost-existing-function",
      "cross-workspace-visual-inconsistency",
      "stale-cache-or-version",
      "failed-regression-test"
    ],
    "restored": [
      "documents-home-navigation",
      "presentations-home-navigation",
      "spreadsheet-normal-drag-range-selection"
    ],
    "regressionSuite": "tests/test_workspace_consistency.py",
    "browserRegression": "tests/browser/revalidate_workspace_consistency.py"
  },
  "localRecoverySystem": {
    "schemaVersion": 3,
    "version": "0.20.3.0",
    "runtime": "shared/local-recovery.js",
    "storage": "IndexedDB",
    "workspaces": [
      "documents",
      "spreadsheets",
      "presentations"
    ],
    "maximumSnapshotsPerDocument": 3,
    "maximumSnapshotsPerWorkspace": 12,
    "maximumAgeDays": 30,
    "restoreChoices": [
      "restore",
      "open-normally",
      "discard"
    ],
    "overwritesOriginalFile": false,
    "clearedAfterConfirmedCopyDownload": false,
    "localProcessing": true,
    "documentation": "docs/DATA_SAFETY_AND_BROWSER_MATRIX.md",
    "documentGenerationWriteBarrier": true,
    "snapshotOnlyClear": true,
    "downloadRequestRetainsSnapshotsUntilDiscardOrReplacement": true,
    "downloadRequestVerification": "browser dispatch is unverified; user must confirm the copy before discarding the workbook",
    "snapshotIsolation": "document+session",
    "legacySnapshotsSupported": true,
    "maximumSnapshotsPerDocumentSession": 3,
    "sessionScopedDiscard": true,
    "workspaceSnapshotLimitPolicy": "target cap; preserve at least one recovery point per independent session"
  },
  "browserMatrix": {
    "schemaVersion": 1,
    "version": "0.20.2",
    "engines": [
      "chromium",
      "firefox",
      "webkit"
    ],
    "defaultUpdateValidation": "chromium",
    "explicitMatrixCommand": "python3 scripts/run_browser_matrix.py",
    "strictEnvironmentVariable": "INKDOS_BROWSER_MATRIX_STRICT=1",
    "documentation": "docs/DATA_SAFETY_AND_BROWSER_MATRIX.md"
  },
  "spreadsheetFormulaEditor": {
    "downloadRequestDoesNotClearUnsavedState": true,
    "recoveryFlushedBeforeDownloadDispatch": true
  }
}
