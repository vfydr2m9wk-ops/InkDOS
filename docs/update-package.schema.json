{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vfydr2m9wk-ops/InkDOS/schemas/update-package-v2.json",
  "title": "InkDOS update package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "packageLabel",
    "sequence",
    "requires",
    "description",
    "validationProfile"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "product": {"const": "InkDOS"},
    "targetRelease": {"type": "string"},
    "packageLabel": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "description": {"type": "string", "minLength": 1},
    "validationProfile": {"enum": ["none", "standard", "full"]},
    "allowWorkflowChanges": {"const": false},
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previousSequence": {"type": "integer", "minimum": 0},
        "appVersions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "beforeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "deletions": {
      "type": "object",
      "additionalProperties": {"type": "object"}
    },
    "textReplacements": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["old", "new"],
          "properties": {
            "old": {"type": "string", "minLength": 1},
            "new": {"type": "string"},
            "count": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "treeReplacements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["old", "new"],
            "properties": {
              "old": {"type": "string", "minLength": 1},
              "new": {"type": "string"},
              "minMatches": {"type": "integer", "minimum": 0},
              "maxMatches": {"type": "integer", "minimum": 0},
              "extensions": {"type": "array", "items": {"type": "string"}},
              "excludePrefixes": {"type": "array", "items": {"type": "string"}},
              "excludePaths": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "fileMerges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "sources"],
            "properties": {
              "target": {"type": "string", "minLength": 1},
              "sources": {"type": "array", "minItems": 2, "items": {"type": "string"}},
              "separator": {"type": "string"},
              "deleteSources": {"type": "boolean"}
            }
          }
        },
        "moves": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
