{
  "schemaVersion": 1,
  "version": "0.19.4.3",
  "description": "Stable shared interface regions exposed by the InkDesk application shell.",
  "regions": {
    "titlebar": {
      "required": true,
      "purpose": "File identity and global commands",
      "dataAttribute": "data-inkdesk-shell-region=titlebar"
    },
    "command-tabs": {
      "required": false,
      "purpose": "Workspace command categories",
      "dataAttribute": "data-inkdesk-shell-region=command-tabs"
    },
    "commandbar": {
      "required": false,
      "multiple": true,
      "purpose": "Commands for the active category",
      "dataAttribute": "data-inkdesk-shell-region=commandbar"
    },
    "workspace": {
      "required": true,
      "multiple": true,
      "purpose": "Primary document content",
      "dataAttribute": "data-inkdesk-shell-region=workspace"
    },
    "statusbar": {
      "required": true,
      "purpose": "Selection, progress, navigation, and zoom status",
      "dataAttribute": "data-inkdesk-shell-region=statusbar"
    }
  },
  "panelSides": [
    "left",
    "right",
    "bottom"
  ],
  "events": [
    "inkdesk:shell-ready",
    "inkdesk:panel-change",
    "inkdesk:command-registered",
    "inkdesk:command-executed",
    "inkdesk:status-change",
    "inkdesk:file-state-change"
  ]
}
