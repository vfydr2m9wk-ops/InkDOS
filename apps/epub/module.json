{
  "schemaVersion": 1,
  "id": "epub",
  "name": "EPUB Reader",
  "description": "A local purple-book reader with lateral pages, text sizing, themes, contents and simple images.",
  "version": "0.20.2.5",
  "enabled": true,
  "optional": true,
  "order": 60,
  "entryPoint": "apps/epub/index.html",
  "icon": "assets/icons/epub.png",
  "badge": "EPUB",
  "themeClass": "epub",
  "accent": "#7655c7",
  "extensions": [
    "epub"
  ],
  "mimeTypes": [
    "application/epub+zip"
  ],
  "capabilities": [
    "open",
    "read-only",
    "copy-export",
    "lateral-pagination",
    "font-size",
    "reading-themes",
    "table-of-contents",
    "simple-images",
    "editable-file-title",
    "unsaved-change-navigation-warning",
    "local-processing"
  ]
}
